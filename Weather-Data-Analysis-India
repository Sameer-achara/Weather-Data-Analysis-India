print("-------- Trend Detection System --------------\n")

print("Trend of Temperature:-\n")

first_temp = df.groupby("City")["Temperature"].first()
last_temp = df.groupby("City")["Temperature"].last()

for city in first_temp.index:
    diff = last_temp[city] - first_temp[city]
    
    if diff > 0:
        print(f"{city} → Increasing")
    elif diff < 0:
        print(f"{city} → Decreasing")
    else:
        print(f"{city} → Stable")


