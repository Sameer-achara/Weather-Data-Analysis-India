print("-------------- Relationship Analyzer ----------\n")

mean_temp=df["Temperature"].mean()
mean_humid=df["Humidity"].mean()
mean_rain=df["Rainfall"].mean()
mean_ws=df["Wind_Speed"].mean()

df["dev_temp"]=df["Temperature"]-mean_temp
df["dev_humid"]=df["Humidity"]-mean_humid
df["dev_rain"]=df["Rainfall"]-mean_rain
df["dev_ws"]=df["Wind_Speed"]-mean_ws

df["sq_dev_temp"]=df["dev_temp"]**2
df["sq_dev_humid"]=df["dev_humid"]**2
df["sq_dev_rain"]=df["dev_rain"]**2
df["sq_dev_ws"]=df["dev_ws"]**2

df["mul_temp_humid"]=df["dev_temp"]*df["dev_humid"]
total_sum_temp_humid=df["mul_temp_humid"].sum()

df["mul_rain_humid"]=df["dev_rain"]*df["dev_humid"]
total_sum_rain_humid=df["mul_rain_humid"].sum()

df["mul_ws_rain"]=df["dev_rain"]*df["dev_ws"]
total_sum_ws_rain=df["mul_ws_rain"].sum()

